<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:DialogueMachine.UI" x:Class="DialogueMachine.UI.MainWindow" Title="Dialogue Machine" Icon="/Assets/app-icon.png" Width="1540" Height="940" MinWidth="1000" MinHeight="680" WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,76,*,32">
    <Menu x:Name="AppMenu" Background="{DynamicResource Panel}" FontSize="12" />
    <Border Grid.Row="1" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="22,12">
      <Grid ColumnDefinitions="250,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Border Width="38" Height="38" Background="{DynamicResource Accent}" CornerRadius="11"><TextBlock Text="D" FontWeight="Bold" FontSize="23" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <StackPanel Spacing="3"><TextBlock Text="Dialogue Machine" FontWeight="SemiBold" FontSize="17"/><TextBlock Text="NARRATIVE WORKSPACE" Classes="eyebrow" FontSize="9"/></StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4" Margin="12,0"><TextBlock x:Name="ProjectTitle" FontWeight="SemiBold" FontSize="17"/><TextBlock x:Name="ProjectSubtitle" Classes="muted" FontSize="12"/></StackPanel>
        <StackPanel Grid.Column="2" x:Name="ProjectActions" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button x:Name="HomeButton" Content="Home" Classes="subtle" ToolTip.Tip="Return to the project welcome screen"/>
          <Button x:Name="UndoButton" Content="↶" FontSize="21" ToolTip.Tip="Undo · Ctrl/Cmd+Z" AutomationProperties.Name="Undo"/>
          <Button x:Name="RedoButton" Content="↷" FontSize="21" ToolTip.Tip="Redo · Ctrl/Cmd+Shift+Z" AutomationProperties.Name="Redo"/>
          <Button x:Name="SaveButton" Content="Save project" ToolTip.Tip="Save · Ctrl/Cmd+S"/>
          <Button x:Name="PlayButton" Content="▶  Playtest" Classes="play" FontWeight="SemiBold" ToolTip.Tip="Play from story start · F5"/>
        </StackPanel>
      </Grid>
    </Border>
    <local:WelcomeView Grid.Row="2" x:Name="Welcome"/>
    <Grid Grid.Row="2" x:Name="WorkspacePanel" IsVisible="False" ColumnDefinitions="250,5,*,5,370">
      <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
          <ScrollViewer x:Name="OutlineHeaderScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" MaxHeight="260">
          <StackPanel Margin="18,22,18,12" Spacing="12">
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="STORY OUTLINE" Classes="eyebrow" VerticalAlignment="Center"/><TextBlock Grid.Column="1" x:Name="SceneCount" Classes="muted" FontSize="12"/></Grid>
            <TextBox x:Name="SearchBox" PlaceholderText="Search scenes and dialogue…" AutomationProperties.Name="Search scenes and dialogue" ToolTip.Tip="Search · Ctrl/Cmd+F"/>
            <Expander x:Name="OutlineFilters" Header="Filter scenes" HorizontalAlignment="Stretch">
              <StackPanel Spacing="6">
                <TextBlock Text="Speaker" FontSize="11" Classes="muted"/><ComboBox x:Name="SpeakerFilter" AutomationProperties.Name="Filter scenes by speaker"/>
                <TextBlock Text="Tag" FontSize="11" Classes="muted"/><ComboBox x:Name="TagFilter" AutomationProperties.Name="Filter scenes by tag"/>
                <TextBlock Text="Group / chapter" FontSize="11" Classes="muted"/><ComboBox x:Name="GroupFilter" AutomationProperties.Name="Filter scenes by group or chapter"/>
                <TextBlock Text="Diagnostics" FontSize="11" Classes="muted"/><ComboBox x:Name="IssueFilter" SelectedIndex="0" AutomationProperties.Name="Filter scenes by diagnostics"><ComboBoxItem>All scenes</ComboBoxItem><ComboBoxItem>With diagnostics</ComboBoxItem><ComboBoxItem>Errors</ComboBoxItem><ComboBoxItem>Warnings</ComboBoxItem><ComboBoxItem>No diagnostics</ComboBoxItem></ComboBox>
              </StackPanel>
            </Expander>
          </StackPanel>
          </ScrollViewer>
          <Button Grid.Row="1" x:Name="ClearFiltersButton" Content="Clear search &amp; filters" Classes="subtle" HorizontalContentAlignment="Left" Margin="18,0,18,8"/>
          <Button Grid.Row="2" x:Name="AddButton" Content="＋  Add scene" Classes="primary" Margin="18,0,18,14" HorizontalContentAlignment="Center"/>
          <Grid Grid.Row="3"><ListBox x:Name="SceneList" SelectionMode="Multiple" AutomationProperties.Name="Story scenes. Ctrl or Cmd toggles scenes; Shift selects a range."/><TextBlock x:Name="OutlineEmpty" Text="No matching scenes. Clear the search or filters to see your story." IsVisible="False" TextWrapping="Wrap" Margin="18,12" FontSize="12" Classes="muted" IsHitTestVisible="False"/></Grid>
          <Border Grid.Row="4" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="18,12">
            <StackPanel Spacing="5"><TextBlock Text="STORY TOOLS" Classes="eyebrow"/><Button x:Name="GroupsButton" Height="32" MinHeight="32" Content="▤   Groups &amp; chapters" Classes="subtle" HorizontalContentAlignment="Left" ToolTip.Tip="Manage groups · Ctrl/Cmd+Shift+G"/><Button x:Name="VariablesButton" Height="32" MinHeight="32" Content="◈   Variables &amp; characters" Classes="subtle" HorizontalContentAlignment="Left"/><Button x:Name="FindReplaceButton" Height="32" MinHeight="32" Content="⌕   Find &amp; replace" Classes="subtle" HorizontalContentAlignment="Left" ToolTip.Tip="Find &amp; replace · Ctrl/Cmd+H"/><Button x:Name="ProblemsButton" Height="32" MinHeight="32" Content="✓   Story diagnostics" Classes="subtle" HorizontalContentAlignment="Left"/></StackPanel>
          </Border>
        </Grid>
      </Border>
      <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Transparent"/>
      <Grid Grid.Column="2" RowDefinitions="58,*,Auto">
        <Border Background="{DynamicResource Base}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="15,10">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="4"><Button x:Name="GraphButton" Content="◇  Story graph" Classes="subtle"/><Button x:Name="ScriptButton" Content="☷  Script" Classes="subtle"/></StackPanel>
            <Button Grid.Column="1" x:Name="LayoutButton" Content="Arrange" ToolTip.Tip="Arrange scenes by their connections. Undo restores the previous layout."/>
          </Grid>
        </Border>
        <Grid Grid.Row="1" ClipToBounds="True">
          <local:GraphCanvas x:Name="Graph" AutomationProperties.Name="Dialogue graph. Ctrl or Cmd+A selects all. Ctrl or Cmd+Tab focuses scenes; Space toggles selection, Enter selects one. Arrows move selected scenes. Escape cancels movement or clears selection."/>
          <ScrollViewer x:Name="ScriptScroll" IsVisible="False"><StackPanel x:Name="ScriptPanel" Margin="28" Spacing="16"/></ScrollViewer>
          <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20" Padding="10,6" MaxWidth="430" Background="{DynamicResource Panel}" CornerRadius="6" IsHitTestVisible="False" x:Name="GraphHint"><StackPanel Spacing="3"><TextBlock x:Name="GraphSelectionSummary" TextWrapping="Wrap" FontSize="11" AutomationProperties.LiveSetting="Polite"/><TextBlock x:Name="CoverageSummary" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MintInk}" AutomationProperties.LiveSetting="Polite"/><StackPanel x:Name="GraphGestures" Spacing="3"><TextBlock Text="Ctrl/Cmd or Shift+click to toggle · Shift+drag to select" TextWrapping="Wrap" FontSize="11" Classes="muted"/><TextBlock Text="Drag selection to move · drag background to pan" TextWrapping="Wrap" FontSize="11" Classes="muted"/></StackPanel></StackPanel></Border>
          <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20" Padding="10,8" Background="{DynamicResource Panel}" CornerRadius="8" x:Name="ZoomBar">
            <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="ZoomOut" Content="−" Classes="subtle" AutomationProperties.Name="Zoom out"/><TextBlock x:Name="ZoomLabel" Text="100%" Width="42" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"/><Button x:Name="ZoomIn" Content="＋" Classes="subtle" AutomationProperties.Name="Zoom in"/><Button x:Name="FitButton" Content="Fit story" Classes="subtle" ToolTip.Tip="Fit all scenes into view · Ctrl/Cmd+0"/></StackPanel>
          </Border>
          <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="20" Padding="10,7" Background="{DynamicResource Panel}" CornerRadius="6" IsHitTestVisible="False" x:Name="GraphLegend"><StackPanel Spacing="3"><TextBlock Text="→ From selection" FontSize="11" Foreground="{DynamicResource GraphSelection}"/><TextBlock Text="← Into selection" FontSize="11" Foreground="{DynamicResource GraphIncoming}"/><TextBlock Text="Dashed: continue" FontSize="11" Classes="muted"/></StackPanel></Border>
          <Border x:Name="MinimapPanel" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" IsVisible="False">
            <StackPanel Spacing="3" Margin="8"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="STORY MAP" Classes="eyebrow" VerticalAlignment="Center"/><Button Grid.Column="1" x:Name="HideMinimap" Content="×" Classes="subtle" AutomationProperties.Name="Hide minimap"/></Grid><local:GraphMinimap x:Name="Minimap" Width="190" Height="120" AutomationProperties.Name="Story minimap. Click or drag to navigate. Arrows pan the viewport, Shift pans farther. Enter or Home fits the story. Escape returns focus to the graph."/><TextBlock Text="Arrows pan · Enter fits" FontSize="10" Classes="muted"/></StackPanel>
          </Border>
        </Grid>
        <Border Grid.Row="2" x:Name="DiagnosticsBorder" IsVisible="False" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" MaxHeight="230">
          <Grid RowDefinitions="Auto,*"><Grid ColumnDefinitions="*,Auto" Margin="16,9"><TextBlock x:Name="DiagnosticsTitle" Text="Story diagnostics" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Grid.Column="1" x:Name="CloseDiagnostics" Content="×" Classes="subtle" AutomationProperties.Name="Close diagnostics"/></Grid><ListBox Grid.Row="1" x:Name="DiagnosticsList" AutomationProperties.Name="Story diagnostics. Select a problem to open its scene."/></Grid>
        </Border>
      </Grid>
      <GridSplitter Grid.Column="3" ResizeDirection="Columns" Background="Transparent"/>
      <Border Grid.Column="4" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
        <Grid RowDefinitions="Auto,Auto,*">
          <StackPanel Margin="22,22,22,16" Spacing="8"><TextBlock Text="SCENE EDITOR" Classes="eyebrow"/><TextBlock x:Name="EditorTitle" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="EditorSubtitle" Classes="muted" FontSize="12"/></StackPanel>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16,0,16,12" Spacing="3"><Button x:Name="ContentTab" Content="Content" Classes="subtle"/><Button x:Name="LogicTab" Content="Logic" Classes="subtle"/><Button x:Name="NotesTab" Content="Notes" Classes="subtle"/></StackPanel>
          <ScrollViewer Grid.Row="2" x:Name="EditorScroll" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="EditorPanel" Margin="22,0,22,24" Spacing="12"/></ScrollViewer>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="3" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="18,6"><Grid ColumnDefinitions="*,Auto,Auto"><TextBlock x:Name="StatusText" FontSize="11" Classes="muted" AutomationProperties.LiveSetting="Polite"/><TextBlock x:Name="StatsText" Grid.Column="1" FontSize="11" Classes="muted" Margin="16,0"/><TextBlock Grid.Column="2" Text="F1  Help" FontSize="11" Classes="muted"/></Grid></Border>
  </Grid>
</Window>
