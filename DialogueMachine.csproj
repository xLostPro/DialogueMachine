<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeFrameworkVersion>10.0.12</RuntimeFrameworkVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DialogueMachine</AssemblyName>
    <RootNamespace>DialogueMachine</RootNamespace>
    <Version>1.5.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
    <ProjectReference Include="Core/DialogueMachine.Core.csproj" />
    <Compile Remove="Core/**/*.cs" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <Compile Remove="tests/**/*.cs" />
    <Compile Remove="CLI/**/*.cs" />
    <Compile Remove="Runtime/**/*.cs" />
    <Compile Remove="Engines/**/*.cs" />
    <None Include="Examples/**/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
