<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="DialogueMachine.App" RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window"><Setter Property="FontFamily" Value="Inter"/><Setter Property="FontSize" Value="14"/><Setter Property="Background" Value="{DynamicResource Base}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>
    <Style Selector="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource Muted}"/></Style>
    <Style Selector="TextBlock.eyebrow"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="LetterSpacing" Value="1.4"/></Style>
    <Style Selector="Button"><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="12,7"/><Setter Property="CornerRadius" Value="7"/><Setter Property="Background" Value="{DynamicResource Raised}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="Button.play"><Setter Property="Background" Value="{DynamicResource Mint}"/><Setter Property="Foreground" Value="#0D2120"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="Button.subtle"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="Button:focus-visible /template/ ContentPresenter"><Setter Property="BorderBrush" Value="{DynamicResource Mint}"/><Setter Property="BorderThickness" Value="2"/></Style>
    <Style Selector="TextBox"><Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="10,8"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Background" Value="{DynamicResource Base}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/></Style>
    <Style Selector="ComboBox"><Setter Property="MinHeight" Value="38"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="Background" Value="{DynamicResource Base}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>
    <Style Selector="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="ListBoxItem"><Setter Property="Padding" Value="10,11"/><Setter Property="Margin" Value="6,2"/><Setter Property="CornerRadius" Value="7"/><Setter Property="MinHeight" Value="44"/></Style>
    <Style Selector="ListBoxItem:selected"><Setter Property="Background" Value="{DynamicResource Selection}"/></Style>
    <Style Selector="TabControl"><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="ToolTip"><Setter Property="MaxWidth" Value="360"/></Style>
  </Application.Styles>
</Application>
