@namespace DialogueMachine.Sample
@page "/"
@using Microsoft.AspNetCore.Components.Web
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using DialogueMachine.Website
@inject NavigationManager Navigation

<!DOCTYPE html>
<html lang="en-GB"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><link rel="icon" href="favicon.svg" /><title>Harbour runtime sample</title><HeadOutlet /></head>
<body><PlayerDemo BundleJson="@bundle" Theme="@theme" Scale="@scale" @rendermode="InteractiveServer" /><script src="_framework/blazor.web.js"></script></body></html>
@code {
    private readonly string bundle = File.ReadAllText(Path.Combine(AppContext.BaseDirectory, "handoff.json"));
    private string theme = "Dark";
    private int scale = 100;
    protected override void OnInitialized()
    {
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
        if (query.TryGetValue("theme", out var t) && t.ToString() is "Dark" or "Light" or "High contrast") theme = t.ToString();
        if (query.TryGetValue("scale", out var s) && int.TryParse(s, out var n) && n is 100 or 115 or 130) scale = n;
    }
}
