@namespace DialogueMachine.Website
@implements IDisposable

<main class="player" style="font-size: @(scale)%" data-theme="@theme">
    <h1>The harbour handoff</h1>
    <p>Choose a path. The host unlocks achievements, updates quests and opens a shop.</p>
    <div class="settings">
        <label>Theme <select @bind="theme"><option>Dark</option><option>Light</option><option>High contrast</option></select></label>
        <label>Text size <select @bind="scale"><option>100</option><option>115</option><option>130</option></select></label>
        <button @onclick="Restart">Restart</button>
    </div>
    @if (error is not null) { <p role="alert">@error</p> }
    @if (player?.Scene is { } scene)
    {
        <p class="scene">Scene: @scene · Page @(player.Page + 1)/@player.Pages.Length</p>
        <p class="dialogue">@player.Pages[player.Page]</p>
        <div class="choices">
            @foreach (var choice in player.Choices)
            {
                <button disabled="@(!choice.Enabled)" @onclick="() => Act(() => player.Select(choice.Id))">@choice.Text</button>
            }
            @if (player.CanContinue) { <button @onclick="() => Act(() => player.Proceed())">@(player.MorePages ? "Next page" : "Continue")</button> }
        </div>
    }
    else if (player is not null) { <p role="status">Conversation ended at @player.EndingScene.</p> }
    @if (host is not null)
    {
        @if (host.OpenShop is { } shop) { <aside aria-label="Shop"><h2>Shop: @shop</h2><p>@string.Join(" · ", host.Stock)</p></aside> }
        <h2>Host effects</h2>
        <p>Achievements: @string.Join(", ", host.Achievements)</p>
        <p>Quests: @string.Join(", ", host.Quests)</p>
        <ol>@foreach (var line in host.Log) { <li>@line</li> }</ol>
    }
</main>
<style>
    body { margin: 0; background: #131b29; font-family: system-ui, sans-serif; }
    .player { --bg: #182235; --fg: #f2f6ff; --accent: #9ae8d4; color: var(--fg); background: var(--bg); max-width: 58rem; margin: auto; padding: 1.5rem; min-height: 100vh; box-sizing: border-box; }
    .player[data-theme="Light"] { --bg: #fafcff; --fg: #1b283b; --accent: #00684e; }
    .player[data-theme="High contrast"] { --bg: #000; --fg: #fff; --accent: #ffff00; }
    .player h1 { font-size: 1.7em; } .player h2 { font-size: 1.15em; }
    .player .settings { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; }
    .player button, .player select { font: inherit; color: var(--fg); background: var(--bg); border: 2px solid var(--accent); border-radius: .25rem; padding: .7em; }
    .player button { cursor: pointer; text-align: left; } .player button:disabled { cursor: default; opacity: .6; border-style: dashed; }
    .player button:focus-visible, .player select:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
    .player .choices { display: grid; gap: .8em; } .player .dialogue { white-space: pre-wrap; font-size: 1.3em; line-height: 1.6; }
    .player p, .player li, .player button { overflow-wrap: anywhere; } .player aside { border: 2px solid var(--accent); padding: 1em; margin-top: 1em; }
    .player .scene { opacity: .8; margin-top: 2em; }
    @@media(max-width: 480px) { .player { padding: 1rem; } .player .settings label { width: 100%; } }
</style>
@code {
    [Parameter, EditorRequired] public string BundleJson { get; set; } = "";
    [Parameter] public string Theme { get; set; } = "Dark";
    [Parameter] public int Scale { get; set; } = 100;
    private RuntimePlayer? player;
    private SampleHost? host;
    private string? error;
    private string theme = "Dark";
    private int scale = 100;
    protected override void OnInitialized() { theme = Theme; scale = Scale; Restart(); }
    private void Restart() { player?.Dispose(); host = new(); error = null; Act(() => player = new RuntimePlayer(BundleJson, host)); }
    private void Act(Action action) { try { action(); } catch (Exception ex) { error = ex.Message; } }
    public void Dispose() => player?.Dispose();
}
